<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Exclude specific directories aggressively
  # Use RewriteCond to ensure these paths are NEVER treated as SPA routes
  RewriteCond %{REQUEST_URI} ^/(marketing|pr) [NC]
  RewriteRule . - [L]

  RewriteRule ^index\.html$ - [L]

  # SPA Routing for everything else
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(marketing|pr) [NC]
  RewriteRule . /index.html [L]
</IfModule>

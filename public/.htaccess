<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  
  # Exclude real directories from rewrite (Duplicate check for safety)
  RewriteCond %{REQUEST_URI} ^/(marketing|pr) [NC]
  RewriteRule .* - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
